# --- Frontend (se incluyen en el bundle: solo claves publicas) ---
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_CLAVE_ANON_PUBLICA

# Modelo multimodal de NVIDIA Build usado por el escaner (opcional).
VITE_NVIDIA_MODEL=meta/llama-3.2-90b-vision-instruct

# Proxy de IA en produccion. Si se deja vacio se usa la Edge Function
# ${VITE_SUPABASE_URL}/functions/v1/ai-classify
VITE_AI_PROXY_URL=

# --- Servidor (NUNCA con prefijo VITE_: no deben llegar al navegador) ---
# Clave de https://build.nvidia.com. En `npm run dev` la usa el proxy de Vite.
NVIDIA_API_KEY=nvapi-TU_CLAVE

# Solo para la sincronizacion del MMA (npm run seed:mma / GitHub Actions).
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE
